    "scripts/postinstall.mjs",
    "sentry-mcp.schema.json",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
