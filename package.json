  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubbedev/sentry-mcp.git"
  },
  "homepage": "https://github.com/stubbedev/sentry-mcp#readme",
  "bugs": {
    "url": "https://github.com/stubbedev/sentry-mcp/issues"
  }
