#!/usr/bin/env php
<?php
// Composer launcher. The PHP twin of bin/cli.mjs: resolves (and, on first run,
// downloads) the prebuilt Go binary for this platform from the GitHub release
// matching package.json's version, then hands stdio to it.
//
// Composer runs no install scripts for dependencies, so the download happens
// here rather than at install time. With ext-pcntl the launcher execs the
// binary and disappears; without it the binary inherits the real stdin/stdout,
// so the idle PHP parent adds no per-message latency, only relays the exit code.

declare(strict_types=1);

const REPO = 'stubbedev/sentry-mcp';

function fail(string $msg): never
{
    fwrite(STDERR, "[sentry-mcp] {$msg}\n");
    exit(1);
}

// Map PHP's OS family and machine type onto the Go release asset naming. Mirrors
// PLATFORMS in scripts/download.mjs.
function target(): array
{
    $os = match (PHP_OS_FAMILY) {
        'Linux' => 'linux',
        'Darwin' => 'darwin',
        'Windows' => 'windows',
        'BSD' => str_contains(strtolower(PHP_OS), 'freebsd') ? 'freebsd' : null,
        default => null,
    };
    $machine = strtolower(php_uname('m'));
    $arch = match (true) {
        in_array($machine, ['x86_64', 'amd64', 'x64'], true) => 'amd64',
        in_array($machine, ['aarch64', 'arm64'], true) => 'arm64',
        str_starts_with($machine, 'armv7') => 'arm',
        in_array($machine, ['i386', 'i586', 'i686', 'x86'], true) => '386',
        $machine === 'ppc64le' => 'ppc64le',
        $machine === 's390x' => 's390x',
        $machine === 'riscv64' => 'riscv64',
        default => null,
    };
    $supported = [
        'linux' => ['amd64', 'arm64', 'arm', '386', 'ppc64le', 's390x', 'riscv64'],
        'darwin' => ['amd64', 'arm64'],
        'windows' => ['amd64', 'arm64', '386'],
        'freebsd' => ['amd64', 'arm64'],
    ];
    if ($os === null || $arch === null || !in_array($arch, $supported[$os], true)) {
        fail(sprintf(
            'Unsupported platform %s/%s. Build from source with: go install github.com/%s@latest',
            PHP_OS, $machine, REPO,
        ));
    }
    return [$os, $arch, $os === 'windows' ? '.exe' : ''];
}

function ensureBinary(): string
{
    $root = dirname(__DIR__);
    [$os, $arch, $ext] = target();
    $dest = "{$root}/bin/sentry-mcp-native{$ext}";
    if (is_file($dest) && filesize($dest) > 0) {
        return $dest;
    }

    // package.json is the single version source: the flake, npm and the binary
    // itself all read it, and publish.yml refuses a tag that disagrees with it.
    $pkg = json_decode((string) @file_get_contents("{$root}/package.json"), true);
    $version = $pkg['version'] ?? fail("cannot read version from {$root}/package.json");

    $url = sprintf('https://github.com/%s/releases/download/v%s/sentry-mcp_%s_%s%s', REPO, $version, $os, $arch, $ext);
    $ctx = stream_context_create(['http' => [
        'follow_location' => 1,
        'user_agent' => 'sentry-mcp-composer',
        'timeout' => 60,
    ]]);
    $in = @fopen($url, 'rb', false, $ctx);
    if ($in === false) {
        fail("Failed to download {$url}: " . (error_get_last()['message'] ?? 'unknown error'));
    }
    $tmp = "{$dest}.download";
    $out = @fopen($tmp, 'wb') ?: fail("cannot write {$tmp}");
    $copied = stream_copy_to_stream($in, $out);
    fclose($in);
    fclose($out);
    if (!$copied) {
        @unlink($tmp);
        fail("Failed to download {$url}: empty response");
    }
    @chmod($tmp, 0755);
    @unlink($dest);
    rename($tmp, $dest) || fail("cannot move {$tmp} to {$dest}");
    return $dest;
}

$bin = ensureBinary();
$args = array_slice($_SERVER['argv'] ?? [], 1);

if (function_exists('pcntl_exec')) {
    pcntl_exec($bin, $args);
    // Only reached when exec failed; fall through to proc_open.
}

$proc = proc_open([$bin, ...$args], [STDIN, STDOUT, STDERR], $pipes);
if (!is_resource($proc)) {
    fail("failed to start {$bin}");
}
exit(proc_close($proc));
